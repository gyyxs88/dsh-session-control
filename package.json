{
  "name": "dsh-session-control",
  "version": "0.6.0",
  "description": "Authorized, durable cross-session control for DeepSeek Harness",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "session-control",
    "cross-session"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyyxs88/dsh-session-control.git"
  },
  "bugs": {
    "url": "https://github.com/gyyxs88/dsh-session-control/issues"
  },
  "homepage": "https://github.com/gyyxs88/dsh-session-control#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./security": "./lib/security.js",
    "./state-store": "./lib/state-store.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.js",
    "check": "node --check lib/index.js && node --check lib/security.js && node --check lib/state-store.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-permission-presets": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-schedule": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-workspace": ">=0.1.0-rc.6"
  },
  "license": "MIT"
}
