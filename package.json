{
  "name": "dsh-session-control",
  "version": "0.8.1",
  "description": "Authorized, durable cross-session control for DeepSeek Harness",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "session-control",
    "cross-session"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyyxs88/dsh-session-control.git"
  },
  "bugs": {
    "url": "https://github.com/gyyxs88/dsh-session-control/issues"
  },
  "homepage": "https://github.com/gyyxs88/dsh-session-control#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./remote-project-bridge": "./lib/remote-project-bridge.js",
    "./remote-manifest": "./lib/remote-manifest.js",
    "./security": "./lib/security.js",
    "./execution-policy-service": "./lib/execution-policy-service.js",
    "./state-store": "./lib/state-store.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "remote": {
      "manifestVersion": "1.0",
      "pluginId": "dsh-session-control",
      "version": "0.8.1",
      "placements": [
        "remote"
      ],
      "protocolVersion": "1.0",
      "apiVersion": "1.0",
      "dshCompatibility": {
        "min": "0.1.0-rc.6",
        "max": "0.1.5-rc.2"
      },
      "capabilities": [
        "session-control.port",
        "schedule.port",
        "remote-project.open",
        "remote-project.schedule-create",
        "remote-project.schedule-delete",
        "remote-project.runtime-auth-begin",
        "remote-project.runtime-auth-confirm",
        "remote-project.execution-policy-verify"
      ],
      "bundledSkills": [
        {
          "id": "dsh-session-control",
          "version": "0.8.0",
          "sha256": "e38372a4c780854b60b043a74f5c5ebc1d20924d338615007bb6f4d9e648b600"
        }
      ]
    }
  },
  "files": [
    "lib",
    "scripts",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "check": "node --check lib/index.js && node --check lib/security.js && node --check lib/state-store.js && node --check lib/operation-notifier.js && node --check lib/remote-manifest.js && node --check lib/remote-project-bridge.js && node --check lib/execution-policy-service.js && node --check lib/session-events.js",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-util-values": "0.1.5-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6 || 0.1.5-rc.2",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.6 || 0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 || 0.1.5-rc.2",
    "@deepseek-ai/dsh-permission-presets": ">=0.1.0-rc.6 || 0.1.5-rc.2",
    "@deepseek-ai/dsh-schedule": ">=0.1.0-rc.6 || 0.1.5-rc.2",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6 || 0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.0-rc.6 || 0.1.5-rc.2",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.6 || 0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.6 || 0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 || 0.1.5-rc.2",
    "@deepseek-ai/dsh-workspace": ">=0.1.0-rc.6 || 0.1.5-rc.2"
  },
  "license": "MIT"
}
